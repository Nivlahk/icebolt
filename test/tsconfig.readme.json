{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "nivlahkicebolt/runtime": ["../src/runtime/index.ts"],
      "nivlahkicebolt/sync": ["../src/sync/index.ts"],
      "nivlahkicebolt/auth": ["../src/auth/index.ts"],
      "nivlahkicebolt/ui": ["../src/ui/index.ts"]
    }
  },
  "include": ["readme-app/**/*.ts"]
}
